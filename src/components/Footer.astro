        </ul>
      </div>
    </div>
    <div class="border-t border-slate-200 pt-8 text-center text-slate-600 text-sm">
      <p>&copy; {currentYear} Executive Research Platform. All rights reserved.</p>
    </div>
  </div>
</footer>
